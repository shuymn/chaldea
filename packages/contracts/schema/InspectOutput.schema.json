{
  "$defs": {
    "Actor": {
      "pattern": "^(human|daemon|thread:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
      "type": "string"
    },
    "Agent": {
      "description": "The CLI a thread runs.",
      "enum": [
        "claude",
        "codex"
      ],
      "type": "string"
    },
    "ApprovalCorrelation": {
      "properties": {
        "tool_use_id": {
          "type": "string"
        }
      },
      "required": [
        "tool_use_id"
      ],
      "type": "object"
    },
    "ApprovalId": {
      "description": "One approval card (§2.10).",
      "format": "uuid",
      "type": "string"
    },
    "ApprovalRequested": {
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "correlation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalCorrelation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only when exactly one `PreToolUse` of the same turn matches (§2.10)."
        },
        "launch_id": {
          "$ref": "#/$defs/LaunchId"
        },
        "tool_input": {
          "$ref": "#/$defs/Content"
        },
        "tool_name": {
          "type": "string"
        },
        "turn_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "approval_id",
        "launch_id",
        "tool_name",
        "tool_input"
      ],
      "type": "object"
    },
    "AttentionCause": {
      "description": "One reason a thread needs a human, each with its own clearing event (§2.2 \"Attention\").",
      "oneOf": [
        {
          "description": "No `SessionStart` 20 s after `launch_started` of a non-manual launch.",
          "properties": {
            "kind": {
              "const": "session_start_timeout",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An expected Codex `Hooks need review` after a CLI upgrade.",
          "properties": {
            "kind": {
              "const": "startup_stall",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "That input entered `unconfirmed`.",
          "properties": {
            "input_id": {
              "$ref": "#/$defs/InputId"
            },
            "kind": {
              "const": "input_unconfirmed",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "input_id"
          ],
          "type": "object"
        },
        {
          "description": "That input stayed `queued` for 60 s.",
          "properties": {
            "input_id": {
              "$ref": "#/$defs/InputId"
            },
            "kind": {
              "const": "input_gate_timeout",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "input_id"
          ],
          "type": "object"
        },
        {
          "description": "A resume was refused because the old launch's death is not confirmed.",
          "properties": {
            "kind": {
              "const": "resume_blocked",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "BlobRef": {
      "properties": {
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the full content.",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size",
        "media_type"
      ],
      "type": "object"
    },
    "CommandId": {
      "description": "A client-generated id that makes a mutating request idempotent (§2.4).",
      "format": "uuid",
      "type": "string"
    },
    "Component": {
      "description": "The minimal A2UI catalog.",
      "oneOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "markdown": {
              "type": "string"
            },
            "type": {
              "const": "markdown",
              "type": "string"
            }
          },
          "required": [
            "type",
            "markdown"
          ],
          "type": "object"
        },
        {
          "properties": {
            "cols": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "grid": {
              "$ref": "#/$defs/Content",
              "description": "The grid in the `vt_snapshot_taken` encoding."
            },
            "rows": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "vt_snapshot",
              "type": "string"
            }
          },
          "required": [
            "type",
            "grid",
            "cols",
            "rows"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "$ref": "#/$defs/SurfaceAction"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "button",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label",
            "action"
          ],
          "type": "object"
        },
        {
          "properties": {
            "label": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "const": "text_input",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "label"
          ],
          "type": "object"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/Component"
              },
              "type": "array"
            },
            "type": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "items"
          ],
          "type": "object"
        }
      ]
    },
    "Content": {
      "anyOf": [
        {
          "properties": {
            "encoding": {
              "$ref": "#/$defs/Encoding"
            },
            "inline": {
              "type": "string"
            }
          },
          "required": [
            "inline",
            "encoding"
          ],
          "type": "object"
        },
        {
          "properties": {
            "blob": {
              "$ref": "#/$defs/BlobRef"
            },
            "preview": {
              "description": "The first `PREVIEW_LIMIT_BYTES` bytes decoded as UTF-8, each invalid\nsequence replaced by U+FFFD. A valid character that crosses the limit is left\nout, not replaced.",
              "type": "string"
            },
            "preview_lossy": {
              "description": "True when any invalid sequence was replaced; a character left out at the\nlimit does not set it.",
              "type": "boolean"
            }
          },
          "required": [
            "blob",
            "preview",
            "preview_lossy"
          ],
          "type": "object"
        }
      ],
      "description": "Every payload field that can be large: inline text or bytes, or a blob reference."
    },
    "Encoding": {
      "description": "`utf8` carries text; `base64` carries bytes that are not valid UTF-8.",
      "enum": [
        "utf8",
        "base64"
      ],
      "type": "string"
    },
    "ErrorBody": {
      "description": "The body of every rejection the daemon decides. `retry_after` is whole seconds and\nabsent (never `null`) when not given.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "retry_after": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "The code of an [`ErrorBody`] (snake_case on the wire). Command PRs add their own refusal\ncodes here.",
      "oneOf": [
        {
          "const": "misdirected_request",
          "description": "421: the `Host` header or the absolute-form authority is not the daemon's.",
          "type": "string"
        },
        {
          "const": "origin_rejected",
          "description": "403: the `Origin` header breaks the route's rule.",
          "type": "string"
        },
        {
          "const": "unauthorized",
          "description": "401.",
          "type": "string"
        },
        {
          "const": "forbidden",
          "description": "403: the token's kind or grant does not allow the action or object.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "404: no such route, command, or object, or one the token cannot read.",
          "type": "string"
        },
        {
          "const": "method_not_allowed",
          "description": "405, with `Allow`.",
          "type": "string"
        },
        {
          "const": "request_timeout",
          "description": "408.",
          "type": "string"
        },
        {
          "const": "length_required",
          "description": "411.",
          "type": "string"
        },
        {
          "const": "payload_too_large",
          "description": "413.",
          "type": "string"
        },
        {
          "const": "bad_request",
          "description": "400: framing, a handshake, or a body that is not the route's.",
          "type": "string"
        },
        {
          "const": "bad_query",
          "description": "400: the query string.",
          "type": "string"
        },
        {
          "const": "bad_args",
          "description": "400: the command arguments.",
          "type": "string"
        },
        {
          "const": "in_progress",
          "description": "409: the command's receipt is still `in_progress`.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "409: the `command_id` belongs to another token or another request.",
          "type": "string"
        },
        {
          "const": "unknown_after_crash",
          "description": "409: the command's receipt was `in_progress` when the daemon restarted.",
          "type": "string"
        },
        {
          "const": "not_implemented",
          "description": "501: the route's or command's handler has not been implemented yet.",
          "type": "string"
        },
        {
          "const": "busy",
          "description": "503: a bounded resource is taken; retry after `retry_after`.",
          "type": "string"
        },
        {
          "const": "disk_full",
          "description": "503.",
          "type": "string"
        },
        {
          "const": "shutting_down",
          "description": "503: the daemon is stopping.",
          "type": "string"
        },
        {
          "const": "store_failed",
          "description": "503: the store refused writes after a fatal error.",
          "type": "string"
        },
        {
          "const": "outcome_unknown",
          "description": "503: the write's outcome is not known; retry with the same `command_id`.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "500.",
          "type": "string"
        },
        {
          "const": "thread_closed",
          "description": "409: resume or close of a closed thread.",
          "type": "string"
        },
        {
          "const": "launch_changed",
          "description": "409: the expected launch is not the thread's current launch.",
          "type": "string"
        },
        {
          "const": "launch_live",
          "description": "409: resume or close (without `stop`) while the current launch has not exited.",
          "type": "string"
        },
        {
          "const": "death_unconfirmed",
          "description": "409: the current launch exited without confirmed death.",
          "type": "string"
        },
        {
          "const": "worktree_unavailable",
          "description": "409: the launch's worktree is not `active` or `released`.",
          "type": "string"
        },
        {
          "const": "no_session",
          "description": "409: resume of a thread with no bound session.",
          "type": "string"
        },
        {
          "const": "prompt_rejected",
          "description": "400: the input encoders' check refused the positional prompt.",
          "type": "string"
        },
        {
          "const": "prompt_too_large",
          "description": "400: the prompt exceeds `MAX_PROMPT_BYTES`.",
          "type": "string"
        },
        {
          "const": "launch_busy",
          "description": "504: a stop could not take its launch and re-read it in time; nothing changed.",
          "type": "string"
        },
        {
          "const": "no_live_launch",
          "description": "409: the thread's current launch is not live for `send`, `ready`, or `key`.",
          "type": "string"
        },
        {
          "const": "not_bound",
          "description": "409: `ready` for a launch with no bound session.",
          "type": "string"
        },
        {
          "const": "card_closed",
          "description": "409: a card key whose card is not open in the launch.",
          "type": "string"
        },
        {
          "const": "key_not_written",
          "description": "409: the key unit wrote zero bytes; a retry may succeed.",
          "type": "string"
        },
        {
          "const": "input_state",
          "description": "409: `input_resolve` of an input not `unconfirmed`, `input_cancel` of one not `queued`.",
          "type": "string"
        },
        {
          "const": "unit_running",
          "description": "409: `ready` while an input unit of the launch may still write.",
          "type": "string"
        }
      ]
    },
    "EventEnvelope": {
      "description": "One stored event. `kind` is an open set and `payload` stays raw until it is decoded\nby kind.",
      "properties": {
        "command_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandId"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "idempotency_key": {
          "$ref": "#/$defs/IdempotencyKey"
        },
        "kind": {
          "$ref": "#/$defs/EventKindTag"
        },
        "launch_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/LaunchId"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Source time, or `recorded_at` when the source states none."
        },
        "payload": true,
        "recorded_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Append time."
        },
        "schema_version": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "seq": {
          "description": "Per stream, gapless, from 1.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "stream_id": {
          "$ref": "#/$defs/StreamId"
        },
        "thread_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThreadId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stream_id",
        "seq",
        "event_id",
        "schema_version",
        "idempotency_key",
        "kind",
        "source",
        "occurred_at",
        "recorded_at",
        "payload"
      ],
      "type": "object"
    },
    "EventId": {
      "description": "Unique per event; generated by the daemon.",
      "format": "uuid",
      "type": "string"
    },
    "EventKindTag": {
      "description": "Event kind on the wire. An open set: readers keep unknown kinds as `GenericEvent`.",
      "type": "string"
    },
    "ExitReason": {
      "oneOf": [
        {
          "enum": [
            "exit",
            "stopped",
            "daemon_restart",
            "unknown_after_crash"
          ],
          "type": "string"
        },
        {
          "const": "spawn_failed",
          "description": "The child never started; reduced as an ordinary exit (`StateInput::Exited`).",
          "type": "string"
        }
      ]
    },
    "GateEvidence": {
      "description": "The gate evidence of the current launch, as thread-stream positions.",
      "properties": {
        "last_human_write_seq": {
          "default": null,
          "description": "The last human write that closes the gate (`attach` or `key`); for `attach`, the\nfirst write of its interval (one event per interval, `docs/design/t1-attach.md` I-5).",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "last_turn_start_seq": {
          "default": null,
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "last_write_seq": {
          "default": null,
          "description": "The last write of any origin.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "readiness_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadinessEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "readiness_seq": {
          "default": null,
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "IdempotencyKey": {
      "description": "Dedupe key, unique per stream (§2.1 \"Idempotency keys\").",
      "type": "string"
    },
    "InputEncoding": {
      "description": "How the input's text reaches the CLI (§2.7 \"Text encoding\", \"First prompt\").",
      "oneOf": [
        {
          "enum": [
            "bracketed_paste",
            "win_keys"
          ],
          "type": "string"
        },
        {
          "const": "positional",
          "description": "The launch's positional argument.",
          "type": "string"
        }
      ]
    },
    "InputId": {
      "description": "One prompt sent through `chaldea send`, the PWA, or `surface_action` (§2.3).",
      "format": "uuid",
      "type": "string"
    },
    "InputInfo": {
      "properties": {
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "encoding": {
          "$ref": "#/$defs/InputEncoding"
        },
        "input_id": {
          "$ref": "#/$defs/InputId"
        },
        "launch_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/LaunchId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sent_after_seq": {
          "default": null,
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/InputState"
        },
        "text": {
          "$ref": "#/$defs/Content"
        }
      },
      "required": [
        "input_id",
        "state",
        "text",
        "encoding",
        "created_by"
      ],
      "type": "object"
    },
    "InputState": {
      "oneOf": [
        {
          "enum": [
            "queued",
            "sending",
            "sent",
            "acked",
            "rejected",
            "cancelled",
            "dismissed"
          ],
          "type": "string"
        },
        {
          "const": "unconfirmed",
          "description": "May have reached the CLI; never resent.",
          "type": "string"
        }
      ]
    },
    "LaunchId": {
      "description": "A launch: one process lifetime of a thread.",
      "format": "uuid",
      "type": "string"
    },
    "LaunchInfo": {
      "properties": {
        "death_confirmed": {
          "type": "boolean"
        },
        "exit_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "launch_id": {
          "$ref": "#/$defs/LaunchId"
        },
        "manual": {
          "type": "boolean"
        },
        "pid": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "launch_id",
        "manual",
        "death_confirmed"
      ],
      "type": "object"
    },
    "OpenAgent": {
      "anyOf": [
        {
          "$ref": "#/$defs/Agent"
        },
        {
          "type": "string"
        }
      ],
      "description": "A known value, or a string this reader does not know."
    },
    "OpenSourceKind": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceKind"
        },
        {
          "type": "string"
        }
      ],
      "description": "A known value, or a string this reader does not know."
    },
    "ProcessState": {
      "enum": [
        "starting",
        "running",
        "stopping",
        "exited"
      ],
      "type": "string"
    },
    "ReadinessEvidence": {
      "oneOf": [
        {
          "enum": [
            "session_start",
            "stop_settled",
            "post_decision"
          ],
          "type": "string"
        },
        {
          "const": "owner_asserted",
          "description": "`chaldea ready` by the owner, for the current bound launch only.",
          "type": "string"
        }
      ]
    },
    "ScreenResponse": {
      "description": "The body of `GET /api/threads/{thread_id}/screen`: the live screen of the thread's current\nlaunch, one text line per row. The daemon builds it with [`ScreenResponse::new`], which\nkeeps the serialized body within [`SCREEN_MAX_BODY`].",
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "cursor": {
          "$ref": "#/$defs/VtCursor",
          "description": "In cell coordinates (a wide character takes two columns)."
        },
        "launch_id": {
          "$ref": "#/$defs/LaunchId"
        },
        "lines": {
          "description": "Exactly `rows` lines, top to bottom: each row's cells without the second half of a\nwide character, combining characters kept, trailing spaces trimmed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "modes": {
          "$ref": "#/$defs/VtModes"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "thread_id": {
          "$ref": "#/$defs/ThreadId"
        },
        "truncated": {
          "description": "Some line was cut to keep the body within its bound.",
          "type": "boolean"
        }
      },
      "required": [
        "thread_id",
        "launch_id",
        "cols",
        "rows",
        "cursor",
        "modes",
        "lines",
        "truncated"
      ],
      "type": "object"
    },
    "SessionInfo": {
      "properties": {
        "session_id": {
          "type": "string"
        },
        "transcript_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "session_id"
      ],
      "type": "object"
    },
    "Source": {
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenAgent"
            },
            {
              "type": "null"
            }
          ]
        },
        "cli_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/OpenSourceKind"
        },
        "transcript": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranscriptPos"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set only for `kind: transcript`."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "SourceKind": {
      "description": "Where an event came from (`source.kind` of the envelope).",
      "enum": [
        "hook",
        "transcript",
        "process",
        "command",
        "daemon",
        "extension"
      ],
      "type": "string"
    },
    "StreamId": {
      "pattern": "^(host|thread:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
      "type": "string"
    },
    "SurfaceAction": {
      "description": "Run only when a human with an owner token clicks its button.",
      "properties": {
        "action_id": {
          "type": "string"
        },
        "args": {
          "description": "Action arguments, validated by the command the action runs."
        },
        "kind": {
          "$ref": "#/$defs/SurfaceActionKind"
        }
      },
      "required": [
        "action_id",
        "kind",
        "args"
      ],
      "type": "object"
    },
    "SurfaceActionKind": {
      "enum": [
        "send_input",
        "send_key",
        "stop",
        "ready",
        "open_attach"
      ],
      "type": "string"
    },
    "SurfaceId": {
      "description": "A surface chosen by its emitter (§2.8).",
      "type": "string"
    },
    "SurfaceScope": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "host",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "workspace",
              "type": "string"
            },
            "workspace_id": {
              "$ref": "#/$defs/WorkspaceId"
            }
          },
          "required": [
            "kind",
            "workspace_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "thread",
              "type": "string"
            },
            "thread_id": {
              "$ref": "#/$defs/ThreadId"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ],
          "type": "object"
        }
      ]
    },
    "SurfaceUpdate": {
      "properties": {
        "components": {
          "description": "An empty list removes the surface.",
          "items": {
            "$ref": "#/$defs/Component"
          },
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/SurfaceScope"
        },
        "surface_id": {
          "$ref": "#/$defs/SurfaceId"
        }
      },
      "required": [
        "surface_id",
        "scope",
        "components"
      ],
      "type": "object"
    },
    "TaskState": {
      "enum": [
        "none",
        "active",
        "blocked",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "ThreadId": {
      "description": "A thread: one agent conversation across all its launches.",
      "format": "uuid",
      "type": "string"
    },
    "ThreadInfo": {
      "properties": {
        "agent": {
          "$ref": "#/$defs/OpenAgent"
        },
        "attention": {
          "description": "Sorted.",
          "items": {
            "$ref": "#/$defs/AttentionCause"
          },
          "type": "array"
        },
        "closed": {
          "type": "boolean"
        },
        "cwd": {
          "type": "string"
        },
        "parent_thread_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThreadId"
            },
            {
              "type": "null"
            }
          ]
        },
        "process_state": {
          "$ref": "#/$defs/ProcessState"
        },
        "role": {
          "$ref": "#/$defs/ThreadRole"
        },
        "task_state": {
          "$ref": "#/$defs/TaskState"
        },
        "thread_id": {
          "$ref": "#/$defs/ThreadId"
        },
        "turn_state": {
          "$ref": "#/$defs/TurnState"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "thread_id",
        "agent",
        "cwd",
        "workspace_id",
        "role",
        "closed",
        "process_state",
        "turn_state",
        "task_state",
        "attention"
      ],
      "type": "object"
    },
    "ThreadRole": {
      "oneOf": [
        {
          "enum": [
            "standard"
          ],
          "type": "string"
        },
        {
          "const": "rescue",
          "description": "Spawned by the owner with `--role rescue`; holds a Rescue token (§2.5).",
          "type": "string"
        }
      ]
    },
    "ThreadSnapshot": {
      "description": "A thread's projection plus its latest events (§2.4).",
      "properties": {
        "gate": {
          "$ref": "#/$defs/GateEvidence"
        },
        "inputs": {
          "description": "Inputs not yet terminal.",
          "items": {
            "$ref": "#/$defs/InputInfo"
          },
          "type": "array"
        },
        "launch": {
          "anyOf": [
            {
              "$ref": "#/$defs/LaunchInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "open_approvals": {
          "items": {
            "$ref": "#/$defs/ApprovalRequested"
          },
          "type": "array"
        },
        "recent_events": {
          "description": "The last `SNAPSHOT_RECENT_EVENTS` events of the stream.",
          "items": {
            "$ref": "#/$defs/EventEnvelope"
          },
          "type": "array"
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "surfaces": {
          "items": {
            "$ref": "#/$defs/SurfaceUpdate"
          },
          "type": "array"
        },
        "thread": {
          "$ref": "#/$defs/ThreadInfo"
        },
        "vt_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/VtSnapshotTaken"
            },
            {
              "type": "null"
            }
          ],
          "description": "The latest `vt_snapshot_taken`, while an attention cause is active or a card is open."
        },
        "worktree": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorktreeChanged"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "thread",
        "gate",
        "inputs",
        "open_approvals",
        "surfaces",
        "recent_events"
      ],
      "type": "object"
    },
    "ThreadSummary": {
      "description": "The body of `GET /api/threads/{thread_id}`: fixed-size facts of one thread, whatever its\nhistory.",
      "properties": {
        "attention_count": {
          "description": "Unresolved attention causes.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "closed": {
          "type": "boolean"
        },
        "launch": {
          "anyOf": [
            {
              "$ref": "#/$defs/LaunchInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "The current launch."
        },
        "process_state": {
          "$ref": "#/$defs/ProcessState"
        },
        "task_state": {
          "$ref": "#/$defs/TaskState"
        },
        "thread_id": {
          "$ref": "#/$defs/ThreadId"
        },
        "turn_state": {
          "$ref": "#/$defs/TurnState"
        }
      },
      "required": [
        "thread_id",
        "closed",
        "process_state",
        "turn_state",
        "task_state",
        "attention_count",
        "launch"
      ],
      "type": "object"
    },
    "Timestamp": {
      "description": "RFC 3339 UTC with millisecond precision, e.g. `2026-11-22T09:45:00.123Z`.",
      "type": "string"
    },
    "TranscriptPos": {
      "description": "Where in a transcript an event's line ended.",
      "properties": {
        "file_id": {
          "type": "string"
        },
        "generation": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "offset_end": {
          "description": "Byte offset just after the line.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "generation",
        "path",
        "file_id",
        "offset_end"
      ],
      "type": "object"
    },
    "TurnState": {
      "enum": [
        "unknown",
        "idle",
        "running",
        "awaiting_approval"
      ],
      "type": "string"
    },
    "VtCursor": {
      "properties": {
        "col": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "row": {
          "description": "Zero-based cell coordinates in the grid.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "row",
        "col",
        "visible"
      ],
      "type": "object"
    },
    "VtModes": {
      "properties": {
        "alternate_screen": {
          "type": "boolean"
        },
        "bracketed_paste": {
          "description": "DECSET 2004.",
          "type": "boolean"
        }
      },
      "required": [
        "bracketed_paste",
        "alternate_screen"
      ],
      "type": "object"
    },
    "VtSnapshotTaken": {
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "cursor": {
          "$ref": "#/$defs/VtCursor"
        },
        "grid": {
          "$ref": "#/$defs/Content",
          "description": "A JSON array of exactly `rows` rows, top to bottom, each an array of at most\n`cols` cell strings, left to right. `\"\"` is the second cell of a wide character and\ndirectly follows it; every other cell is non-empty (a blank cell is `\" \"`). Trailing\nblank cells are omitted; a reader fills them back to `cols`. A grid of any other\nshape is an unreadable snapshot. Above 64 KiB the grid is a blob, fetched before\ndecoding (`docs/design/pty-runtime.md` §2.6)."
        },
        "modes": {
          "$ref": "#/$defs/VtModes"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "grid",
        "cols",
        "rows",
        "cursor",
        "modes"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "description": "Derived from the canonical path of the repository's common git directory,\nor of the cwd outside git (§2.1).",
      "type": "string"
    },
    "WorktreeChanged": {
      "description": "The full worktree record, carried on every change.",
      "properties": {
        "base_commit": {
          "description": "The resolved SHA of `base_ref`.",
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "owner_thread_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThreadId"
            },
            {
              "type": "null"
            }
          ],
          "description": "`null` when the human owner holds it."
        },
        "path": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/WorktreeState"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "worktree_id": {
          "$ref": "#/$defs/WorktreeId"
        }
      },
      "required": [
        "worktree_id",
        "repo",
        "workspace_id",
        "path",
        "branch",
        "base_ref",
        "base_commit",
        "created_by",
        "state"
      ],
      "type": "object"
    },
    "WorktreeId": {
      "description": "8 hex characters, also the worktree's directory name (§2.6).",
      "type": "string"
    },
    "WorktreeState": {
      "enum": [
        "creating",
        "active",
        "released",
        "removing",
        "uncertain",
        "removed",
        "failed"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The output of `chaldea inspect <thread> --json`. On success `snapshot` is set and\n`summary` is not; when the snapshot could not be read for its size or in time, `summary`\nis the thread's [`ThreadSummary`] instead (no attention causes, session, inputs, cards,\nor events). `screen` is the live screen of the launch the read showed; each error is the\ndaemon's, or the client's own (`payload_too_large`, `request_timeout`, `internal`).",
  "properties": {
    "screen": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScreenResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "screen_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorBody"
        },
        {
          "type": "null"
        }
      ],
      "description": "`launch_changed` when the screen is of another launch than the one read."
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorBody"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread_id": {
      "$ref": "#/$defs/ThreadId"
    }
  },
  "required": [
    "thread_id",
    "snapshot",
    "summary",
    "screen",
    "snapshot_error",
    "screen_error"
  ],
  "title": "InspectOutput",
  "type": "object"
}
