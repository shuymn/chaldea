{
  "$defs": {
    "Agent": {
      "description": "The CLI a thread runs.",
      "enum": [
        "claude",
        "codex"
      ],
      "type": "string"
    },
    "CommandId": {
      "description": "A client-generated id that makes a mutating request idempotent (§2.4).",
      "format": "uuid",
      "type": "string"
    },
    "EventId": {
      "description": "Unique per event; generated by the daemon.",
      "format": "uuid",
      "type": "string"
    },
    "EventKindTag": {
      "description": "Event kind on the wire. An open set: readers keep unknown kinds as `GenericEvent`.",
      "type": "string"
    },
    "IdempotencyKey": {
      "description": "Dedupe key, unique per stream (§2.1 \"Idempotency keys\").",
      "type": "string"
    },
    "LaunchId": {
      "description": "A launch: one process lifetime of a thread.",
      "format": "uuid",
      "type": "string"
    },
    "OpenAgent": {
      "anyOf": [
        {
          "$ref": "#/$defs/Agent"
        },
        {
          "type": "string"
        }
      ],
      "description": "A known value, or a string this reader does not know."
    },
    "OpenSourceKind": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceKind"
        },
        {
          "type": "string"
        }
      ],
      "description": "A known value, or a string this reader does not know."
    },
    "Source": {
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenAgent"
            },
            {
              "type": "null"
            }
          ]
        },
        "cli_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/OpenSourceKind"
        },
        "transcript": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranscriptPos"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set only for `kind: transcript`."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "SourceKind": {
      "description": "Where an event came from (`source.kind` of the envelope).",
      "enum": [
        "hook",
        "transcript",
        "process",
        "command",
        "daemon",
        "extension"
      ],
      "type": "string"
    },
    "StreamId": {
      "pattern": "^(host|thread:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
      "type": "string"
    },
    "ThreadId": {
      "description": "A thread: one agent conversation across all its launches.",
      "format": "uuid",
      "type": "string"
    },
    "Timestamp": {
      "description": "RFC 3339 UTC with millisecond precision, e.g. `2026-11-22T09:45:00.123Z`.",
      "type": "string"
    },
    "TranscriptPos": {
      "description": "Where in a transcript an event's line ended.",
      "properties": {
        "file_id": {
          "type": "string"
        },
        "generation": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "offset_end": {
          "description": "Byte offset just after the line.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "generation",
        "path",
        "file_id",
        "offset_end"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One stored event. `kind` is an open set and `payload` stays raw until it is decoded\nby kind.",
  "properties": {
    "command_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommandId"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_id": {
      "$ref": "#/$defs/EventId"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "kind": {
      "$ref": "#/$defs/EventKindTag"
    },
    "launch_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/LaunchId"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Source time, or `recorded_at` when the source states none."
    },
    "payload": true,
    "recorded_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Append time."
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "seq": {
      "description": "Per stream, gapless, from 1.",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "stream_id": {
      "$ref": "#/$defs/StreamId"
    },
    "thread_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "stream_id",
    "seq",
    "event_id",
    "schema_version",
    "idempotency_key",
    "kind",
    "source",
    "occurred_at",
    "recorded_at",
    "payload"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
