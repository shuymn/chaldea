{
  "$defs": {
    "LaunchId": {
      "description": "A launch: one process lifetime of a thread.",
      "format": "uuid",
      "type": "string"
    },
    "ThreadId": {
      "description": "A thread: one agent conversation across all its launches.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The arguments of `ready`.",
  "properties": {
    "expected_launch_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/LaunchId"
        },
        {
          "type": "null"
        }
      ],
      "description": "When given, the current launch must be this one (`launch_changed` otherwise)."
    },
    "thread_id": {
      "$ref": "#/$defs/ThreadId"
    }
  },
  "required": [
    "thread_id"
  ],
  "title": "ReadyArgs",
  "type": "object"
}
